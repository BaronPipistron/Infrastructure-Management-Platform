{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "ParserSvc reads Structurizr deployment manifests in JSON format and exposes host-centric desired state for Drift Detector.\n\nMVP behavior:\n- reads manifests at startup only\n- supports file or directory mode\n- parses Structurizr deployment model and keeps desired state in memory",
        "title": "ParserSvc API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/desired-state": {
            "get": {
                "description": "Returns full in-memory desired state with metadata.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "desired-state"
                ],
                "summary": "Get full desired state",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.DesiredStateResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/desired-state/hosts": {
            "get": {
                "description": "Returns hosts from desired state. Supports fqdn query and label-based filters with AND semantics.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "desired-state"
                ],
                "summary": "List desired hosts",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Host FQDN filter",
                        "name": "fqdn",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Label filter example",
                        "name": "env",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Label filter example",
                        "name": "managed_by",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Label filter example",
                        "name": "purpose",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.HostsResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/desired-state/hosts/{hostId}": {
            "get": {
                "description": "Returns full desired host details.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "desired-state"
                ],
                "summary": "Get desired host by ID",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Host ID",
                        "name": "hostId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.HostResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.APIError"
                        }
                    }
                }
            }
        },
        "/healthz": {
            "get": {
                "description": "Returns service liveness state.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.HealthResponse"
                        }
                    }
                }
            }
        },
        "/readyz": {
            "get": {
                "description": "Returns readiness state based on startup manifest loading.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Readiness check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.ReadinessResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.ReadinessResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "internal_transport_http.APIError": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "host not found"
                }
            }
        },
        "internal_transport_http.DesiredHostDTO": {
            "type": "object",
            "properties": {
                "env": {
                    "type": "string"
                },
                "fqdn": {
                    "type": "string"
                },
                "host_id": {
                    "type": "string"
                },
                "ip": {
                    "type": "string"
                },
                "labels": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "managed_by": {
                    "type": "string"
                },
                "purpose": {
                    "type": "string"
                },
                "workloads": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/internal_transport_http.DesiredWorkloadDTO"
                    }
                }
            }
        },
        "internal_transport_http.DesiredStateDTO": {
            "type": "object",
            "properties": {
                "hosts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/internal_transport_http.DesiredHostDTO"
                    }
                }
            }
        },
        "internal_transport_http.DesiredStateMetadata": {
            "type": "object",
            "properties": {
                "filesBroken": {
                    "type": "integer"
                },
                "filesIgnored": {
                    "type": "integer"
                },
                "filesLoaded": {
                    "type": "integer"
                },
                "filesTotal": {
                    "type": "integer"
                },
                "hostsTotal": {
                    "type": "integer"
                },
                "loadedAt": {
                    "type": "string"
                },
                "manifestMode": {
                    "type": "string"
                },
                "manifestPath": {
                    "type": "string"
                },
                "ready": {
                    "type": "boolean"
                },
                "readyReason": {
                    "type": "string"
                },
                "workloadsTotal": {
                    "type": "integer"
                }
            }
        },
        "internal_transport_http.DesiredStateResponse": {
            "type": "object",
            "properties": {
                "desiredState": {
                    "$ref": "#/definitions/internal_transport_http.DesiredStateDTO"
                },
                "metadata": {
                    "$ref": "#/definitions/internal_transport_http.DesiredStateMetadata"
                }
            }
        },
        "internal_transport_http.DesiredWorkloadDTO": {
            "type": "object",
            "properties": {
                "deployment_mode": {
                    "type": "string"
                },
                "enabled": {
                    "type": "boolean"
                },
                "image": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "port": {
                    "type": "integer"
                },
                "version": {
                    "type": "string"
                }
            }
        },
        "internal_transport_http.HealthResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "internal_transport_http.HostResponse": {
            "type": "object",
            "properties": {
                "host": {
                    "$ref": "#/definitions/internal_transport_http.DesiredHostDTO"
                },
                "metadata": {
                    "$ref": "#/definitions/internal_transport_http.HostResponseMetadata"
                }
            }
        },
        "internal_transport_http.HostResponseMetadata": {
            "type": "object",
            "properties": {
                "filesBroken": {
                    "type": "integer"
                },
                "filesLoaded": {
                    "type": "integer"
                },
                "loadedAt": {
                    "type": "string"
                }
            }
        },
        "internal_transport_http.HostsResponse": {
            "type": "object",
            "properties": {
                "hosts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/internal_transport_http.DesiredHostDTO"
                    }
                },
                "metadata": {
                    "$ref": "#/definitions/internal_transport_http.HostsResponseMetadata"
                }
            }
        },
        "internal_transport_http.HostsResponseMetadata": {
            "type": "object",
            "properties": {
                "filesBroken": {
                    "type": "integer"
                },
                "filesLoaded": {
                    "type": "integer"
                },
                "loadedAt": {
                    "type": "string"
                },
                "returnedHosts": {
                    "type": "integer"
                },
                "totalHosts": {
                    "type": "integer"
                },
                "workloadsTotal": {
                    "type": "integer"
                }
            }
        },
        "internal_transport_http.ReadinessResponse": {
            "type": "object",
            "properties": {
                "brokenFiles": {
                    "type": "integer"
                },
                "hostsTotal": {
                    "type": "integer"
                },
                "loadedFiles": {
                    "type": "integer"
                },
                "readyReason": {
                    "type": "string"
                },
                "status": {
                    "type": "string",
                    "example": "ready"
                }
            }
        }
    }
}